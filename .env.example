# Optional overrides. Leave unset to use the defaults.
#
# In development the app calls /api/wa and /api/shop, which Vite proxies to the
# real services (no CORS needed). In a production build it calls the services
# directly, so either the backend must allow your admin origin (CORS) or you
# must put a reverse proxy in front and point these at it.

# WhatsApp / core service (login, products, invoices, customers, business)
# VITE_WA_API_URL=https://api.prod.whatsapp-service.epocketshop.store

# ePocketShop service (subscriptions)
# VITE_SHOP_API_URL=https://api.prod.epocketshop-service.epocketshop.store

# Public storefront base and tools that open in a new tab / iframe
# VITE_STOREFRONT_URL=https://epocketshop.store
# VITE_ANALYTICS_URL=https://api.prod.data-analysis-service.epocketshop.store
# VITE_AI_AGENT_URL=https://api.prod.ai-service.epocketshop.store
