{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/icons/*", "/*.svg", "/*.png", "/*.ico", "/manifest.webmanifest", "/sw.js"]
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "MimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
